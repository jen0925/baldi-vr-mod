+			{
+				if (elevator.IsOpen && elevator.ColliderGroup != null)
+				{
+					next = elevator;
+					break;
+				}
+			}
+			if (next == null)
+			{
+				break;
+			}
+			int closedBefore = elevatorsClosed;
+			Bounds doorway = new Bounds(next.ColliderGroup.transform.position, Vector3.zero);
